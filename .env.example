SECRET_KEY=change-me
DEBUG=1
DB_NAME=analytics
DB_USER=analytics
DB_PASSWORD=analytics
DB_HOST=localhost
DB_PORT=5432
# Shared cache, websocket groups and Celery. Set to 0 only if Redis is not running.
USE_REDIS=1
REDIS_URL=redis://localhost:6379
BASE_DOMAIN=localhost
# Prints the signup link in the server terminal. Leave this as console unless SMTP is really set up.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
STRIPE_SECRET_KEY=
STRIPE_METERED_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
EMAIL_HOST=localhost
EMAIL_PORT=25
EVENT_RETENTION_DAYS=90
